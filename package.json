{
  "name": "trimmy",
  "version": "0.1.0",
  "private": true,
  "description": "Trimmy \u2014 learn stocks by playing a Wall Street simulation.",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/domain"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10.9.8 <11"
  },
  "scripts": {
    "build": "npm run build:backend && npm run build:web",
    "build:backend": "tsc -b packages/domain apps/api",
    "build:web": "npm run build --workspace @trimmy/web",
    "typecheck": "tsc -b packages/domain apps/api --pretty false && tsc -p tsconfig.tests.json && npm run typecheck --workspace @trimmy/web",
    "test": "npm run build:backend && node --import tsx --test packages/domain/test/*.test.ts apps/api/test/*.test.ts && npm run test:web",
    "test:web": "npm run test --workspace @trimmy/web",
    "test:practice-db": "bash infra/tests/run-practice-postgres.sh",
    "test:career-red-day-db": "bash infra/tests/run-career-red-day-postgres.sh",
    "test:paper-reset-db": "bash infra/tests/run-paper-reset-postgres.sh",
    "test:career-reason-sharing-db": "bash infra/tests/run-career-reason-sharing-postgres.sh",
    "test:migration-db": "bash infra/tests/run-migration-postgres.sh",
    "test:deployment": "bash infra/tests/run-deployment-smoke.sh",
    "test:mobile-sync": "TRIMMY_PRACTICE_TEST_MOBILE=1 bash infra/tests/run-practice-postgres.sh",
    "dev:api": "npm run build:backend && npm run dev --workspace @trimmy/api",
    "dev:web": "npm run dev --workspace @trimmy/web",
    "preview:web": "npm run preview --workspace @trimmy/web",
    "start:api": "npm run start --workspace @trimmy/api",
    "check": "npm run build:backend && npm run check:content && npm run check:discovery-contract && npm run check:wallet-possession-contract && npm run test:wallet-possession-contract && npm run typecheck && npm test && npm run test:provider-tools && npm run build:web && npm run test:solana && npm run test:stock-mints && npm run test:stock-inspection",
    "generate:content": "node tool/generate-practice-catalog.mjs",
    "check:content": "node tool/generate-practice-catalog.mjs --check && node tool/check-practice-copy.mjs && npm run test:content",
    "test:content": "node --test tool/test/practice-catalog.test.mjs tool/test/practice-copy.test.mjs",
    "build:review:android": "python3 tool/build-review-android.py",
    "test:markets": "npm run build:backend && node --import tsx --test apps/api/test/market-estimates.test.ts apps/api/test/stock-estimates.test.ts",
    "test:market-live": "node --import tsx tool/testing/market-estimate-smoke.mjs",
    "test:stock-estimate-live": "node --import tsx tool/testing/stock-estimate-smoke.mjs",
    "test:stock-orders": "npm run build:backend && node --import tsx --test apps/api/test/stock-order-draft.test.ts",
    "test:stock-inspection": "node --import tsx --test tool/testing/stock-order-wallet.test.mjs tool/testing/mainnet-stock-order-inspection.test.mjs tool/testing/stock-order-return.test.mjs",
    "verify:stock-funding": "node --import tsx tool/testing/mainnet-stock-order-inspection.mjs --balances",
    "verify:prestocks-live": "node --import tsx tool/testing/prestocks-live.mjs --live-read",
    "verify:stock-return-local": "node --import tsx tool/testing/stock-order-return-local.mjs",
    "return:mainnet": "node --import tsx tool/testing/stock-order-return.mjs",
    "test:solana": "node --test tool/testing/solana-devnet.test.mjs",
    "test:solana-devnet": "node tool/testing/solana-devnet.mjs",
    "test:stocks": "npm run build:backend && node --import tsx --test apps/api/test/stock-discovery*.test.ts",
    "test:stock-live": "node --import tsx tool/testing/stock-discovery-smoke.mjs",
    "test:stock-history-live": "node --import tsx tool/testing/tokens-variant-history-schema.mjs --one-read",
    "test:raydium-stock-live": "node --import tsx tool/testing/raydium-stock-quote-smoke.mjs --live-read-only",
    "test:web-market-live": "node --import tsx tool/testing/web-market-live-read.mjs --live-read-only",
    "test:stock-mints": "node --test tool/testing/stock-mint-inspection.test.mjs",
    "test:x-profiles": "npm run build:backend && node --import tsx --test apps/api/test/x-profile-lookup*.test.ts apps/api/test/x-profile-route*.test.ts",
    "test:provider-tools": "node --import tsx --test tool/testing/privy-app-settings.test.mjs tool/testing/secret-boundary-check.test.mjs tool/testing/tokens-variant-history-schema.test.mjs tool/testing/x-profile-recheck.test.mjs tool/testing/device-account-lifecycle.test.mjs tool/testing/mobile-stock-panel-live.test.mjs tool/runtime/local-secure-runtime.test.mjs tool/runtime/apply-migrations.test.mjs tool/runtime/run-guest-retention.test.mjs tool/runtime/career-red-day-worker.test.mjs",
    "verify:privy-settings": "node --import tsx tool/testing/privy-app-settings.mjs --read-only",
    "runtime:init": "node tool/runtime/local-secure-runtime.mjs init",
    "runtime:migrate": "node tool/runtime/local-secure-runtime.mjs migrate",
    "runtime:red-day": "node tool/runtime/local-secure-runtime.mjs red-day",
    "db:migrate": "node tool/runtime/apply-migrations.mjs",
    "db:grants": "node tool/runtime/apply-migrations.mjs --grants-only",
    "db:retain-guests": "node tool/runtime/run-guest-retention.mjs",
    "runtime:start": "node tool/runtime/local-secure-runtime.mjs start",
    "runtime:stop": "node tool/runtime/local-secure-runtime.mjs stop",
    "runtime:status": "node tool/runtime/local-secure-runtime.mjs status",
    "test:runtime-tools": "node --test tool/runtime/local-secure-runtime.test.mjs tool/runtime/apply-migrations.test.mjs tool/runtime/run-guest-retention.test.mjs tool/runtime/career-red-day-worker.test.mjs",
    "test:device-lifecycle": "node tool/testing/device-account-lifecycle.mjs",
    "verify:secret-boundary": "node tool/testing/secret-boundary-check.mjs",
    "generate:discovery-contract": "node --import tsx tool/generate-discovery-contract.mjs",
    "check:discovery-contract": "node --import tsx tool/generate-discovery-contract.mjs --check",
    "generate:wallet-possession-contract": "node --import tsx tool/generate-wallet-possession-contract.mjs",
    "check:wallet-possession-contract": "node --import tsx tool/generate-wallet-possession-contract.mjs --check",
    "test:wallet-possession-contract": "node --import tsx --test tool/test/wallet-possession-contract.test.mjs",
    "backup:database": "bash tool/runtime/backup-database.sh"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "@solana/kit": "5.5.1",
    "@solana-program/system": "0.10.0",
    "@solana-program/token-2022": "0.6.1",
    "@solana/sysvars": "5.5.1"
  },
  "overrides": {
    "axios": "1.18.0",
    "ws@>=8 <9": "8.21.3"
  },
  "packageManager": "npm@10.9.8"
}
