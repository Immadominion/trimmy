# Only the API consumes this file. Never bundle private credentials in Flutter.
HOST=127.0.0.1
PORT=4100
LOG_LEVEL=info
# There is deliberately no flag that enables financial operations.
# Leave all three unset for local-only practice. Set all three to enable the
# verified practice account/backup adapters after migrations and runtime grants.
# PRIVY_VERIFICATION_KEY is the app's ES256 SPKI PUBLIC key, not a private key.
# Literal \n sequences are accepted in this key. Token verification itself does
# not need the Privy app secret.
# PRIVY_APP_ID=
# PRIVY_VERIFICATION_KEY=
# PRACTICE_DATABASE_URL=postgresql://runtime-user:password@db-host:5432/postgres
# Guest creation source protection is required whenever practice accounts are
# enabled. The key is a stable, canonical base64url encoding of exactly 32
# random bytes. Keep it server-only and consistent across every API replica.
# Direct mode uses the transport peer and ignores forwarding headers.
# TRIMMY_GUEST_SOURCE_MODE=direct
# TRIMMY_GUEST_SOURCE_HMAC_KEY=
# Trusted-proxy mode is only for an API reached through known proxies. Supply a
# strict JSON CIDR list; an untrusted peer or malformed/ambiguous chain fails.
# TRIMMY_GUEST_SOURCE_MODE=trusted_proxy
# TRIMMY_GUEST_TRUSTED_PROXY_CIDRS=["10.0.0.0/8","2001:db8::/32"]
# Optional account-context enrichment additionally requires the Privy app
# secret on this API process. Missing app ID or secret keeps the route disabled.
# PRIVY_APP_SECRET=
# Relationship support is opt in and must stay false until migration 0025, the
# provider budgets, moderation operations and release checks are complete.
# TRIMMY_RELATIONSHIP_SAFETY_ENABLED=false
# Live relationship readiness also reads the exact moderation role name. This is
# a non-secret identifier and the only TRIMMY_MIGRATION_* setting intentionally
# shared with the serving API. It grants no credential or role membership. Omit
# it when using the default, or use the same custom name in the release command.
# TRIMMY_MIGRATION_SOCIAL_MODERATOR_ROLE=trimmy_social_moderator
# Optional wallet possession checks, disabled unless both values are explicit.
# Requires all verified-account settings and PRIVY_APP_SECRET above, migration
# 0007 and SELECT/INSERT grants on wallet_bindings for the restricted role.
# Single API process only: challenge nonces and rate limiting live in memory;
# bindings are durable. A restart makes outstanding challenges unusable.
# This signs no transaction and enables no financial operation.
# TRIMMY_WALLET_POSSESSION=single_process
# TRIMMY_WALLET_NETWORK=mainnet-beta
# Optional authenticated, read-only SOL/USDC/AAPLx holdings. Both variables
# are required, and the linked-identity/account settings above must also be on.
# The URL may contain a provider key and must remain server-only.
# TRIMMY_STOCK_HOLDINGS=solana_mainnet
# SOLANA_MAINNET_RPC_URL=https://your-mainnet-rpc.example
# Database TLS certificate verification is required; URL query options rejected.
# Optional pinned PEM bundle for that verification (for example a hosted
# provider's CA, or the local secure runtime's CA). Omit to use the process
# trust store. Never a private key.
# PRACTICE_DATABASE_CA_FILE=/path/to/database-ca.crt
#
# Applying migrations is a separate step with separate, higher privileges.
# Except for the non-secret moderator role name documented above, these
# variables belong to that one-off release command
# (node tool/runtime/apply-migrations.mjs, or npm run db:migrate) and must NOT
# be set on the serving API process, which uses the restricted role above.
# TLS is always verified; a URL query option cannot turn it off. Because the
# protected tables use FORCE RLS without owner policies, this URL's role must
# be SUPERUSER or BYPASSRLS. The runner verifies that before any DDL and also
# verifies every Trimmy security-definer, API and internal function owner
# before activation.
# TRIMMY_MIGRATION_DATABASE_URL=postgresql://owner-user:password@db-host:5432/trimmy
# TRIMMY_MIGRATION_DATABASE_CA_FILE=/path/to/database-ca.crt
# The restricted role that receives table privileges after migrating.
# Defaults to trimmy_practice_runtime.
# TRIMMY_MIGRATION_RUNTIME_ROLE=trimmy_practice_runtime
# Provision the safe NOLOGIN, NOINHERIT moderation role before running the
# current migration tool. The tool grants it one moderation function only and
# proves the API and worker roles cannot enter it.
# TRIMMY_MIGRATION_SOCIAL_MODERATOR_ROLE=trimmy_social_moderator
# Migration 0025 is a stop-the-world invitation authority cutover. Stop every
# trimmy-practice-api database pool first. This acknowledgment is required when
# 0025 is pending, and the runner independently verifies that no pool remains.
# TRIMMY_MIGRATION_RELATIONSHIP_CUTOVER=drained-v2
# Red-day evidence uses a NOINHERIT login which can SET ROLE into one NOLOGIN
# capability. Provision both before migration 0021. The apply tool verifies
# their flags, exclusive membership, exact four-function grant and zero table
# authority before it can activate the mission.
# TRIMMY_MIGRATION_RED_DAY_WORKER_ROLE=trimmy_red_day_worker
# TRIMMY_MIGRATION_RED_DAY_CAPABILITY_ROLE=trimmy_red_day_verifier
# Keep false until the Tokens.xyz market-data terms decision is recorded and
# the separately scheduled worker is deployable. Activation is an explicit,
# final grants-only step and is safe to repeat.
# TRIMMY_MIGRATION_ACTIVATE_RED_DAY=false
# Schedule one bounded owner-only retention batch separately from the API once
# per minute. Batch 1000 provides capacity for 60,000 rows in each category per
# hour. A later invocation continues when hasMore=true.
# npm run db:retain-guests -- --batch 1000
# Optional native HTTPS listener. Both files are required together; a partial
# pair stops startup instead of silently serving plain HTTP. Behind a TLS proxy
# leave both unset.
# TRIMMY_TLS_CERT_FILE=/path/to/api.crt
# TRIMMY_TLS_KEY_FILE=/path/to/api.key
# Browser callers additionally need an explicit list of canonical HTTPS origins.
# Empty/unset allows originless native clients only. No cookies or wildcard CORS.
# TRIMMY_WEB_ORIGINS=["https://your-web-domain.example"]
# Optional read-only mainnet SOL/USDC and pinned AAPLx/USDC estimates; this never
# enables swaps, wallets, eligibility or the approved asset catalog.
# Disabled by default. Use keyless_research only for bounded local testing.
# A public deployment needs api_key access and a shared gateway request budget.
# TRIMMY_MARKET_QUOTES=disabled
# JUPITER_API_KEY=
# Optional issuer-variant discovery. Requires a Tokens.xyz assets:read key.
# TRIMMY_STOCK_DISCOVERY=tokens_xyz
# TOKENS_API_KEY=
# The red-day worker is a separate one-pass process, never the serving API.
# It requires the dedicated login URL, pinned database CA, capability role,
# explicit canonical equity catalog and bounded batch sizes. TOKENS_API_KEY is
# supplied only to this worker process. Run it from an external scheduler; one
# invocation performs one bounded pass and never loops internally.
# TRIMMY_RED_DAY_DATABASE_URL=postgresql://trimmy_red_day_worker:password@db-host:5432/trimmy
# TRIMMY_RED_DAY_DATABASE_CA_FILE=/path/to/database-ca.crt
# TRIMMY_RED_DAY_WORKER_ROLE=trimmy_red_day_worker
# TRIMMY_RED_DAY_CAPABILITY_ROLE=trimmy_red_day_verifier
# TRIMMY_RED_DAY_ASSET_CATALOG_JSON={"apple":"AAPL"}
# TRIMMY_RED_DAY_CANDIDATE_LIMIT=20
# TRIMMY_RED_DAY_EVIDENCE_BATCH_LIMIT=50
# Discovery data does not enable or populate the approved trading catalog.
# Optional observed mint-specific candles from Tokens.xyz. This reuses the
# server-only key above and does not claim canonical exchange history or units.
# TRIMMY_STOCK_HISTORY=tokens_xyz
# Read-only pre-IPO stock catalog from PreStocks (keyless public API). No execution.
# TRIMMY_PRESTOCKS=public
# Optional independent Raydium compute quotes for the same pinned AAPLx/USDC
# pair. This is keyless comparison data and never requests transaction bytes.
# TRIMMY_RAYDIUM_STOCK_QUOTES=read_only
# Optional server-only X public-profile lookup. It is exposed only with the
# verified existing-account runtime above; it does not prove handle ownership.
# The local secure runtime reads this from macOS Keychain only when started with
# --with-relationship-safety. Do not add it to the local runtime api.env file.
# X_BEARER_TOKEN=
# X OAuth client secrets belong in the configured auth provider dashboard,
# not in Flutter/React builds or these server token-verification settings.

# Optional Crossmint USDC funding. These variables belong to the API only.
# Server scopes: orders.create, orders.read, users.create. Client: orders.read.
# Leave disabled until both keys exist. Production additionally needs Crossmint
# Onramp approval/enablement; creating API keys alone does not enable payments.
# CROSSMINT_ENVIRONMENT=staging
# CROSSMINT_SERVER_SIDE_API_KEY=
# CROSSMINT_CLIENT_SIDE_API_KEY=
