server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;

  # A single-page app: unknown paths are the app's own routes, not 404s.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Hashed assets are immutable; the entry document never is.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
  }
  location = /index.html {
    add_header Cache-Control "no-store" always;
    # add_header in a location replaces inherited headers. SPA routes, including
    # wallet recovery, must keep their own anti-framing and referrer protections.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
  }

  # This bundle is not an API and should never be framed or sniffed.
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
}
