/* Copy placement and an app preview using the actual product_theme.dart palette. */
.story-screen{--story-drift:0px;position:absolute;pointer-events:none;z-index:4;color:#fff;will-change:opacity,transform}
.story-screen--intro{inset-inline:0;top:50%;padding-inline:24px;text-align:center;transform:translate3d(0,calc(-50% + var(--story-drift)),0)}
.story-screen--scene{left:max(100px,10vw);bottom:max(100px,13vh);width:min(620px,62vw);transform:translate3d(0,var(--story-drift),0);text-shadow:0 2px 30px #000,0 2px 5px #0006}
.story-screen--product{left:max(100px,11vw);top:48%;width:min(490px,38vw);transform:translate3d(0,calc(-50% + var(--story-drift)),0)}
.story-title{font-family:var(--font-display);font-size:clamp(1.6rem,3vw,2.5rem);font-weight:800;line-height:1.1;letter-spacing:-.035em;text-wrap:balance;max-width:24ch;margin:0}
.story-screen--intro .story-title{margin-inline:auto;max-width:22ch}
.story-screen--product .story-title{font-size:clamp(2.2rem,3.6vw,3.7rem);max-width:18ch}
.story-title--body{max-width:40ch}.story-title--body span,.story-body span{display:block}
.story-stamp{font-size:11px;font-weight:700;letter-spacing:.28em;margin-bottom:18px;color:#ffffffa8}
.story-body{margin-top:22px;max-width:42ch;font-size:clamp(.98rem,1.3vw,1.1rem);line-height:1.65;letter-spacing:-.015em;color:#ffffffb8;text-wrap:pretty}
.story-signature{display:flex;flex-direction:column;align-items:flex-start;gap:12px;margin-top:28px}
.story-lockup{display:flex;align-items:center;gap:14px;color:#ffffff80;font-size:16px}
.story-wordmark{display:flex;align-items:center;gap:6px;color:white;font:800 32px/1 var(--font-display);letter-spacing:-.055em}
.story-wordmark img{height:34px;width:34px;object-fit:contain}.story-powered{font-size:11px;color:#ffffff70}
.story-note{margin-top:20px;font-size:12px;color:#ffffff75;line-height:1.6}
.story-status{margin:28px 0 0;display:grid;gap:24px}.story-status dt{font-size:12px;font-weight:800;margin-bottom:8px;color:#fff}.story-status dd{margin:0;font-size:16px;line-height:1.65;max-width:40ch;color:#ffffffa6}
.story-action{pointer-events:auto;display:inline-flex;gap:32px;align-items:center;margin-top:30px;padding:15px 22px;border-radius:99px;background:white;color:#151515;text-decoration:none;font-size:14px;font-weight:800;transition:background .2s,transform .2s}
.story-action:hover{transform:translateY(-2px);background:#e9e1ff}.story-action:focus-visible{outline:2px solid white;outline-offset:6px}.story-action span{font-size:19px}.story-footer{margin-top:27px;color:#ffffff6b;font-size:11px;line-height:1.6}

.product-showcase{--phone-arrival:0;--phone-height:min(73svh,690px);position:absolute;right:12vw;top:50%;width:calc(var(--phone-height) * .49);height:var(--phone-height);z-index:3;transform:translateY(-50%) translateX(calc(var(--phone-arrival) * 30px)) scale(calc(1 + var(--phone-arrival) * .12));transform-origin:center;container-type:inline-size;pointer-events:auto;will-change:opacity,transform}
.product-phone{position:relative;width:100%;height:100%;padding:2.2cqw;border:1px solid #918f9b;border-radius:14cqw;background:linear-gradient(140deg,#c0bfcc,#484750 12%,#0b0b0e 25%,#33333b 75%,#a3a0af);box-shadow:inset 0 0 0 1px #ffffff35,18px 30px 70px #0008,-1px 0 10px #d4c5ff2b}
.product-phone::before,.product-phone::after{content:"";position:absolute;width:3px;background:#7b7985;border:1px solid #131318;border-radius:2px}.product-phone::before{height:15cqw;left:-3px;top:33cqw}.product-phone::after{height:18cqw;right:-3px;top:44cqw}
.product-phone-screen{position:relative;overflow:hidden;width:100%;height:100%;border-radius:11.8cqw;background:#f7f2e8;color:#17211b;isolation:isolate;font-family:var(--font-body);font-size:4cqw;font-weight:600;letter-spacing:-.025em;box-shadow:0 0 0 1px #08080b}
.product-phone-status{position:absolute;inset:4.2cqw 6cqw auto;z-index:5;display:flex;align-items:center;justify-content:space-between;font-size:3cqw;font-weight:800;line-height:1}
.product-demo-badge{position:absolute;left:50%;top:8cqw;transform:translateX(-50%);font-size:2.8cqw;font-weight:700;border:1px solid #17211b20;border-radius:20px;padding:.9cqw 2.5cqw;color:#677069;background:#fffaf0;letter-spacing:.02em}
.product-phone-island{position:absolute;width:28cqw;height:7cqw;left:50%;top:2.2cqw;transform:translateX(-50%);border-radius:99px;z-index:6;background:#111114}
.product-phone-signal{display:flex;align-items:center;gap:1.6cqw;font-size:2.4cqw}.product-phone-signal i{width:6cqw;height:3cqw;border:1px solid #17211b80;border-radius:1cqw;background:#17211b;box-shadow:inset 0 0 0 1px #f7f2e8}
.product-phone-home{position:absolute;bottom:2.5cqw;left:35%;width:30%;height:1.2cqw;border-radius:20px;background:#17211b;z-index:8}
.product-pane{position:absolute;inset:0}.product-pane-content{position:absolute;inset:23cqw 6cqw 23cqw;display:flex;flex-direction:column;gap:3.4cqw;overflow:hidden}
.product-pane-title{font:800 8cqw/1.04 var(--font-display);letter-spacing:-.045em;margin:0 0 1cqw;text-wrap:balance}.product-pane h4{font-size:4.7cqw;font-weight:800;line-height:1.15;margin:0}.product-pane p{margin:0;line-height:1.45}
.product-tabs{position:absolute;inset:auto 0 5cqw;height:16cqw;border-top:1px solid #d8d5c9;display:flex;align-items:center;padding:1.6cqw 3cqw 0;background:#fffcf5}
.product-tabs>div{width:25%;display:flex;flex-direction:column;align-items:center;gap:.8cqw;font-size:2.8cqw;color:#677069;font-weight:800}.product-tabs span{display:grid;place-items:center;width:13cqw;height:7.5cqw;border-radius:3cqw}.product-tabs svg{width:5.2cqw;height:5.2cqw}.product-tabs .is-active{color:#075d43}.product-tabs .is-active span{background:#ddefe5}
.product-button{display:flex;justify-content:space-between;align-items:center;gap:2cqw;width:100%;min-height:max(12cqw,44px);padding:2.8cqw 5cqw;border:none;border-radius:4cqw;color:#fff;background:#075d43;box-shadow:0 1.2cqw 0 #034631;font:800 3.8cqw/1.2 var(--font-body);cursor:pointer;transition:background .2s,transform .2s}
.product-button:hover{background:#087553}.product-button:active{transform:translateY(1cqw)}.product-button:focus-visible,.product-empty button:focus-visible,.product-stock-picker button:focus-visible{outline:2px solid #7867e8;outline-offset:3px}.product-button>span{font-size:5cqw}
.product-demo-note{display:block;font-size:2.9cqw;color:#677069;line-height:1.4}.product-showcase-caption{margin:17px 0 0;text-align:center;font-size:10px;letter-spacing:.03em;color:#ffffff65}
.product-brand{display:flex;gap:1.3cqw;align-items:center;font:800 9cqw/1 var(--font-display);letter-spacing:-.06em}.product-brand img{width:9cqw;height:9cqw;object-fit:contain}
.product-welcome{position:absolute;inset:23cqw 7cqw 10cqw;display:flex;flex-direction:column;align-items:center;text-align:center;gap:4cqw}
.product-welcome-art{position:relative;width:100%;min-height:30cqw;max-height:61cqw;flex:1;display:flex;justify-content:center}.product-welcome-sal{height:100%;max-width:73%;object-fit:contain;filter:drop-shadow(0 8px 7px #17211b12)}
.product-float-stock{position:absolute;width:15cqw;height:15cqw;display:grid;place-items:center;border-radius:50%;box-shadow:1cqw 2cqw 4cqw #17211b18}.product-float-stock img{width:100%;height:100%;object-fit:contain;border-radius:50%}.product-float-stock--apple{left:0;top:8cqw;transform:rotate(-14deg)}.product-float-stock--nvidia{right:0;bottom:9cqw;transform:rotate(12deg)}.product-float-star{position:absolute;right:7cqw;top:2cqw;font-size:10cqw;color:#e1a72b}
.product-welcome h3{font:800 9cqw/.99 var(--font-display);letter-spacing:-.04em;margin:0}.product-welcome>p{font-size:3.8cqw;max-width:26ch;color:#677069}.product-welcome .product-button{margin-top:1cqw}
.product-user{display:flex;align-items:center;gap:3cqw}.product-avatar{width:11cqw;height:11cqw;background:#ffc845;border:1.5px solid #17211b;display:grid;place-items:center;border-radius:4cqw;font-size:5cqw;font-weight:800}.product-user>div:nth-child(2){display:flex;flex-direction:column;gap:.6cqw}.product-user strong{font-size:4.7cqw}.product-user span{font-size:3cqw;color:#677069}.product-user-badge{margin-left:auto;padding:1.6cqw;background:#fffcf5;border:1px solid #d8d5c9;border-radius:20px;white-space:nowrap}
.product-balance{margin-top:2cqw;padding:5cqw;color:#fff;background:#17211b;border-radius:7cqw}.product-balance>span{font-size:3.5cqw;color:#d7e2d9}.product-balance>strong{display:block;font:800 12cqw/1.2 var(--font-display);margin-top:2cqw;letter-spacing:-.04em}.product-balance>strong span{color:#ffffff70;font-size:7cqw}.product-balance p{color:#c0cfc4;font-size:3cqw}.product-balance-rule{height:1px;background:#ffffff25;margin:4cqw 0}.product-balance>div:last-child{display:grid;grid-template-columns:1fr 1fr;gap:1.4cqw;font-size:3cqw}.product-balance>div:last-child span{color:#c0cfc4}.product-balance>div:last-child b{text-align:right;font-size:3.3cqw}
.product-section-heading{display:flex;justify-content:space-between;align-items:center;margin-top:2cqw}.product-section-heading span{font-size:3cqw;color:#677069}.product-empty{border:1px dashed #c9c9bb;border-radius:5cqw;padding:4cqw;text-align:center;background:#fffcf5}.product-empty>span{font-size:7cqw;color:#075d43}.product-empty p{font-size:3.3cqw;margin:1cqw 0 3cqw}.product-empty button{color:#075d43;background:none;border:none;font:800 3.5cqw var(--font-body);cursor:pointer}
.product-sal-message{display:flex;align-items:center;gap:2cqw;margin-top:auto}.product-sal-message img{width:16cqw;height:18cqw;object-fit:contain}.product-sal-message b{font-size:3.3cqw}.product-sal-message p{font-size:3.2cqw;margin-top:1cqw;color:#677069}
.product-search{display:flex;align-items:center;gap:3cqw;padding:3cqw 4cqw;border:1px solid #d8d5c9;border-radius:4cqw;background:#fffcf5;color:#677069;font-size:3.5cqw}.product-search>span{font-size:6cqw;line-height:.8}.product-chip{display:inline-flex;align-self:flex-start;padding:1.7cqw 3cqw;font-size:2.9cqw;font-weight:800;background:#ffc845;border-radius:2cqw}
.product-stock-picker{display:flex;gap:2.5cqw}.product-stock-picker button{flex:1;display:flex;flex-direction:column;align-items:center;gap:2cqw;border:1px solid #d8d5c9;background:#fffcf5;padding:3cqw 1cqw;border-radius:4cqw;color:#17211b;cursor:pointer;font:700 3cqw var(--font-body)}.product-stock-picker button[aria-pressed=true]{border-color:#075d43;box-shadow:inset 0 0 0 1px #075d43;background:#e9f1e8}.product-stock-picker img{width:10cqw;height:10cqw;border-radius:50%}
.product-stock-detail{border:1px solid #d8d5c9;border-radius:5cqw;background:#fffcf5;padding:4cqw}.product-stock-detail>div:first-child{display:flex;justify-content:space-between;align-items:center}.product-stock-detail>div:first-child span{font-size:2.9cqw;color:#677069}.product-stock-detail h4{margin-top:1cqw}.product-stock-detail>div:first-child img{width:11cqw;height:11cqw;border-radius:50%}.product-stock-detail>strong{display:inline-block;font:800 8.5cqw var(--font-display);margin-top:3cqw;margin-right:3cqw}.product-gain{color:#087957}.product-stock-detail>.product-gain{font-size:3cqw}
.product-chart{width:100%;height:24cqw;margin-top:3cqw;overflow:visible}.product-chart--small{height:18cqw;margin:1cqw 0}.product-chart-grid{fill:none;stroke:#d8d5c9;stroke-width:.7}.product-chart-fill{fill:#ddefe580}.product-chart-line{fill:none;stroke:#075d43;stroke-width:2.7;stroke-linejoin:round;stroke-linecap:round}.product-chart-periods{display:flex;justify-content:space-around;align-items:center;padding-top:2cqw;font-size:2.8cqw;color:#677069}.product-chart-periods b{background:#ddefe5;color:#075d43;padding:1cqw 3cqw;border-radius:2cqw}
.product-mission-sal{display:flex;align-items:center;gap:3cqw;min-height:37cqw}.product-mission-sal img{width:33cqw;height:38cqw;object-fit:contain}.product-mission-sal>div{position:relative;font-size:3.8cqw;padding:3.5cqw;background:#fffcf5;border:1px solid #d8d5c9;border-radius:5cqw;line-height:1.5}.product-mission-sal span{display:block;font-size:2.7cqw;color:#677069;margin-top:2cqw}
.product-mission{display:flex;align-items:flex-start;gap:3cqw;padding:4cqw;border-radius:5cqw;border:1px solid #075d43;background:#e8f1e8}.product-mission-number{display:grid;place-items:center;flex-shrink:0;width:9cqw;height:9cqw;background:#075d43;color:white;border-radius:50%;font-weight:800;font-size:3.5cqw}.product-mission h4{font-size:4.3cqw}.product-mission p{font-size:3.3cqw;color:#677069;margin-top:1.5cqw}.product-mission b{display:block;color:#075d43;font-size:3.3cqw;margin-top:3cqw}.product-mission b span{font-weight:600;color:#677069}.product-mission--next{border-color:#d8d5c9;background:#fffcf5}.product-mission--next .product-mission-number{background:#e5e3d9;color:#677069}
.product-trim-stock{display:flex;align-items:center;gap:3cqw;margin-top:1cqw}.product-trim-stock img{width:12cqw;height:12cqw;border-radius:50%}.product-trim-stock span{display:block;font-size:3cqw;color:#677069;margin-top:1cqw}.product-trim-stock>b{margin-left:auto;color:#087957;font-size:4cqw}.product-trim-explanation{font-size:3.3cqw;line-height:1.65;color:#677069}
.product-trim-stats{display:grid;grid-template-columns:1fr 1fr;background:#fffcf5;border:1px solid #d8d5c9;border-radius:5cqw}.product-trim-stats>div{padding:3cqw}.product-trim-stats>div+div{border-left:1px solid #d8d5c9}.product-trim-stats span{display:block;font-size:2.8cqw;color:#677069}.product-trim-stats strong{display:block;font:800 10cqw/1.2 var(--font-display);margin-top:1cqw}
.product-trim-result{display:flex;align-items:center;gap:2cqw;padding:3cqw;border-radius:3cqw;font-size:3.3cqw;line-height:1.5;min-height:18cqw}.product-trim-result.is-sold{background:#ddefe5;color:#075d43}.product-trim-result svg{width:6cqw;height:6cqw;flex-shrink:0}
.product-rank-hero{text-align:center;padding:2cqw 0 3cqw}.product-rank-hero>span{display:inline-grid;place-items:center;width:22cqw;height:22cqw;background:#ffc845;border:1px solid #d89500;border-radius:7cqw;font-size:14cqw;line-height:1;transform:rotate(-7deg);box-shadow:0 1.4cqw 0 #d89500}.product-rank-hero h4{margin-top:4cqw;font:800 8cqw var(--font-display)}.product-rank-hero p{font-size:3.2cqw;color:#677069;margin-top:1cqw}
.product-rank-points{display:flex;align-items:center;justify-content:space-between;padding-bottom:3cqw;border-bottom:1px solid #d8d5c9}.product-rank-points b{font-size:5cqw}.product-rank-points b span{font-size:3cqw}.product-rank-points>span{font-size:2.9cqw;color:#677069;max-width:15ch;text-align:right}.product-rank-path{display:grid;gap:2cqw}.product-rank-path>div{display:flex;align-items:center;gap:3cqw;min-height:8cqw;font-size:3.6cqw;color:#677069}.product-rank-path>div>span:first-child{display:grid;place-items:center;width:7cqw;height:7cqw;border:1px solid #d8d5c9;border-radius:50%;background:#fffcf5;font-size:3cqw}.product-rank-path .is-current{color:#075d43}.product-rank-path .is-current>span:first-child{background:#075d43;border-color:#075d43;color:#fff}.product-rank-path em{font-size:2.7cqw;font-style:normal;margin-left:auto}.product-rank-lock{margin-left:auto}
.product-build-brand{width:100%;text-align:center;padding-block:2cqw}.product-build-brand img{width:29cqw;height:29cqw;object-fit:contain}.product-build-label{font-size:2.9cqw;letter-spacing:.1em;color:#677069}.product-built-list{display:grid;gap:3.5cqw}.product-built-list>div{display:flex;align-items:center;gap:3cqw;font-size:3.7cqw}.product-built-list svg{width:5cqw;height:5cqw;color:#075d43}.product-coming{padding:4cqw;background:#e9e2f8;border-radius:4cqw;margin-top:2cqw}.product-coming b{font-size:4cqw}.product-coming p{color:#5f556e;font-size:3.5cqw;margin-top:2cqw}

@media(min-width:1500px){.product-showcase{right:16vw}.story-screen--product{left:16vw;width:34vw}}
@media(max-width:900px) and (min-width:701px){.product-showcase{right:8vw;--phone-height:min(68svh,580px)}.story-screen--product{left:10vw;width:37vw}.story-screen--product .story-title{font-size:35px}}
@media(max-width:700px){
.story-screen--scene{left:26px;bottom:max(112px,15svh);width:calc(100% - 52px)}.story-screen--scene .story-title{max-width:26ch;font-size:clamp(25px,6.6vw,33px)}.story-screen--scene .story-body{font-size:14px;line-height:1.6;max-width:39ch;margin-top:17px}
.story-screen--product{inset-inline:25px;width:auto;top:max(77px,10svh);transform:translate3d(0,var(--story-drift),0);text-align:center}.story-screen--product .story-title{font-size:clamp(26px,7.4vw,35px);max-width:20ch;margin-inline:auto}.story-screen--product .story-body{font-size:13px;line-height:1.5;margin:13px auto 0;max-width:42ch}
.story-signature{align-items:center;gap:5px;margin-top:13px}.story-lockup{gap:9px;font-size:11px}.story-wordmark{font-size:24px}.story-wordmark img{width:25px;height:25px}.story-powered{font-size:9px}.story-note{margin-top:9px;font-size:10px}
.story-status{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:15px;text-align:left}.story-status dt{font-size:10px;margin-bottom:5px}.story-status dd{font-size:11px;line-height:1.5}.story-action{margin-top:14px;padding:10px 17px;font-size:12px;gap:20px}.story-footer{margin-top:10px;font-size:9px}
.product-showcase{--phone-height:min(58svh,510px);right:auto;left:50%;top:auto;bottom:max(70px,8svh);transform:translateX(-50%) translateY(calc(var(--phone-arrival) * 25px)) scale(calc(1 + var(--phone-arrival) * .08))}.product-showcase-caption{margin-top:10px;font-size:8px}
}
@media(max-width:700px) and (max-height:720px){.story-screen--product{top:69px}.story-screen--product .story-title{font-size:25px}.story-screen--product .story-body{font-size:12px;margin-top:9px}.story-signature{flex-direction:row;justify-content:center;gap:13px;margin-top:9px}.story-note{font-size:9px;margin-top:7px}.product-showcase{--phone-height:52svh;bottom:66px}.story-status dd{font-size:10px}.story-footer{margin-top:7px}}
@media(max-height:560px) and (min-width:701px){.product-showcase{--phone-height:76svh}.story-screen--product .story-title{font-size:31px}.story-body{font-size:14px}.story-status{gap:14px;margin-top:18px}.story-status dd{font-size:13px}}
@media(prefers-reduced-motion:reduce){.product-button,.story-action{transition:none}}

@media(max-width:700px){.product-stock-picker button{min-height:44px}.product-empty button{min-height:40px}.product-pane-content{gap:3cqw}.product-chart-periods{display:none}}

/* Short phones get a compact app layout, not a miniature desktop phone. */
@media (max-width: 700px) {
  .product-showcase-caption { display: none; }
}
@media (max-width: 700px) and (max-height: 720px) {
  .product-showcase {
    --phone-height: min(400px, calc(100svh - 296px));
    width: min(260px, calc(100vw - 96px));
    bottom: 78px;
  }
  main:has(.story-screen--product[aria-hidden="false"] .story-action) .product-showcase {
    --phone-height: min(366px, calc(100svh - 330px));
  }
  .product-phone { border-radius: 30px; padding: 5px; }
  .product-phone-screen { border-radius: 25px; }
  .product-phone-island { width: 68px; height: 15px; top: 5px; }
  .product-phone-status { inset: 10px 18px auto; font-size: 9px; }
  .product-demo-badge { top: 15px; font-size: 9px; padding: 2px 8px; }
  .product-phone-home { bottom: 7px; height: 3px; }
  .product-tabs { display: none; }
  .product-pane-content { inset: 45px 14px 17px; gap: 5px; }
  .product-pane-title { font-size: 19px; margin-bottom: 3px; }
  .product-pane h4 { font-size: 12px; }
  .product-chip { font-size: 9px; padding: 4px 7px; }
  .product-demo-note { font-size: 9px; line-height: 1.4; }
  .product-button { min-height: 44px; flex-shrink: 0; padding: 10px 13px; border-radius: 10px; font-size: 12px; box-shadow: 0 3px 0 #034631; }
  .product-button > span { font-size: 16px; }
  .product-chart { display: none; }

  .product-welcome { inset: 45px 20px 18px; gap: 7px; }
  .product-brand { font-size: 24px; }
  .product-brand img { width: 25px; height: 25px; }
  .product-welcome-art { min-height: 55px; max-height: 92px; }
  .product-welcome h3 { font-size: 22px; }
  .product-welcome > p { display: none; }
  .product-float-stock { width: 31px; height: 31px; }
  .product-float-stock--apple { top: 7px; left: 14px; }
  .product-float-stock--nvidia { bottom: 6px; right: 12px; }
  .product-float-star { font-size: 22px; top: 2px; right: 30px; }

  .product-user { gap: 8px; }
  .product-avatar { width: 29px; height: 29px; font-size: 16px; border-radius: 9px; }
  .product-user strong { font-size: 13px; }
  .product-user span { font-size: 9px; }
  .product-user-badge { padding: 5px; }
  .product-balance { margin-top: 4px; padding: 10px 13px; border-radius: 15px; }
  .product-balance > span, .product-balance p { font-size: 10px; }
  .product-balance > strong { margin-top: 3px; font-size: 30px; }
  .product-balance > strong span { font-size: 19px; }
  .product-balance-rule { margin: 7px 0; }
  .product-balance > div:last-child { gap: 3px; font-size: 9px; }
  .product-balance > div:last-child b { font-size: 10px; }
  .product-section-heading { margin-top: 5px; }
  .product-section-heading span { font-size: 9px; }
  .product-empty { padding: 7px; border-radius: 12px; }
  .product-empty > span, .product-sal-message { display: none; }
  .product-empty p { margin: 0; font-size: 10px; }
  .product-empty button { font-size: 11px; min-height: 37px; }

  .product-pane-content:has(.product-stock-picker) > .product-chip,
  .product-pane-content:has(.product-stock-picker) > .product-demo-note { display: none; }
  .product-stock-picker { gap: 6px; }
  .product-stock-picker button { padding: 5px; gap: 3px; font-size: 10px; min-height: 49px; border-radius: 10px; }
  .product-stock-picker img { width: 23px; height: 23px; }
  .product-stock-detail { padding: 8px 10px; border-radius: 12px; }
  .product-stock-detail > div:first-child span { font-size: 9px; }
  .product-stock-detail > div:first-child img { width: 28px; height: 28px; }
  .product-stock-detail > strong { font-size: 26px; margin: 2px 8px 0 0; }
  .product-stock-detail > .product-gain { font-size: 10px; }

  .product-mission-sal { gap: 7px; min-height: 0; }
  .product-mission-sal img { width: 60px; height: 76px; }
  .product-mission-sal > div { font-size: 10px; padding: 7px; border-radius: 12px; line-height: 1.4; }
  .product-mission-sal span { font-size: 9px; margin-top: 4px; }
  .product-mission { gap: 8px; padding: 9px; border-radius: 12px; }
  .product-mission-number { width: 25px; height: 25px; font-size: 10px; }
  .product-mission p { font-size: 10px; margin-top: 3px; }
  .product-mission b { font-size: 10px; margin-top: 5px; }
  .product-mission--next { display: none; }

  .product-pane-content:has(.product-trim-stock) > .product-pane-title,
  .product-pane-content:has(.product-trim-stock) > .product-chip { display: none; }
  .product-trim-stock { gap: 8px; margin-top: 1px; }
  .product-trim-stock img { width: 29px; height: 29px; }
  .product-trim-stock span { font-size: 10px; margin-top: 2px; }
  .product-trim-stock > b { font-size: 12px; }
  .product-trim-explanation { font-size: 11px; line-height: 1.5; margin-top: 3px; }
  .product-trim-stats { border-radius: 12px; }
  .product-trim-stats > div { padding: 6px 9px; }
  .product-trim-stats span { font-size: 10px; }
  .product-trim-stats strong { font-size: 28px; margin-top: 2px; }
  .product-trim-result { padding: 7px; font-size: 11px; line-height: 1.4; min-height: 48px; border-radius: 8px; }
  .product-trim-result svg { width: 19px; height: 19px; }

  .product-rank-hero { display: grid; grid-template-columns: 42px 1fr; grid-template-rows: auto auto; gap: 2px 12px; text-align: left; padding: 3px 0; }
  .product-rank-hero > span { grid-row: 1 / 3; width: 39px; height: 39px; border-radius: 12px; font-size: 29px; }
  .product-rank-hero h4 { margin: 0; font-size: 20px; }
  .product-rank-hero p { font-size: 9px; margin-top: 0; }
  .product-rank-points { padding-bottom: 5px; }
  .product-rank-points b { font-size: 17px; }
  .product-rank-points b span, .product-rank-points > span { font-size: 9px; }
  .product-rank-path { gap: 3px; }
  .product-rank-path > div { min-height: 23px; gap: 8px; font-size: 11px; }
  .product-rank-path > div > span:first-child { width: 22px; height: 22px; font-size: 10px; }
  .product-rank-path em { font-size: 9px; }

  .product-build-brand { padding: 0; }
  .product-build-brand img { width: 53px; height: 53px; }
  .product-build-label { font-size: 9px; }
  .product-built-list { gap: 8px; }
  .product-built-list > div { font-size: 11px; gap: 8px; }
  .product-built-list svg { width: 16px; height: 16px; }
  .product-coming { padding: 10px; margin-top: 3px; border-radius: 10px; }
  .product-coming b { font-size: 12px; }
  .product-coming p { font-size: 10px; margin-top: 4px; }
}

@media (max-width: 700px) and (max-height: 720px) {
  /* Keep the stock action inside the short phone's visible screen. */
  .product-user-badge { display: none; }
  .product-balance { padding: 9px 12px; margin-top: 2px; }
  .product-balance > span { display: block; font-size: 10px; line-height: 1.2; }
  .product-balance > strong { margin-top: 3px; font-size: 28px; line-height: 1.05; }
  .product-balance > strong span { font-size: 18px; }
  .product-balance p { display: none; }
  .product-balance-rule { margin: 5px 0; }
  .product-balance > div:last-child { gap: 2px; line-height: 1.2; }
  .product-empty { padding: 6px; }
  .product-empty p { display: none; }
  .product-empty button { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 44px; padding: 8px 10px; font-size: 12px; background: #075d43; color: white; border-radius: 9px; }

  /* Secondary art and repeated copy give way to the mission and build facts. */
  .product-pane-content:has(.product-mission) > .product-chip,
  .product-mission-sal span,
  .product-mission p { display: none; }
  .product-build-brand,
  .product-pane-content:has(.product-build-brand) > .product-demo-note { display: none; }
  .product-built-list { gap: 6px; }
  .product-built-list > div { line-height: 1.4; }
  .product-coming { padding: 8px; }
}

@media (max-width: 700px) and (max-height: 720px) {
  .product-pane-content:has(.product-mission) > * { flex-shrink: 0; }
  .product-mission-sal { min-height: 70px; }
  .product-mission-sal img { width: 54px; height: 64px; flex-shrink: 0; }
}

@media (max-width: 700px) and (max-height: 720px) {
  /* Six visible trim rows: their heights no longer depend on flex shrinking
     or the desktop cqw minimums. Leave room below the action for the demo note. */
  .product-pane-content:has(.product-trim-stock) {
    display: grid;
    grid-template-rows: 32px 32px 58px auto 44px 14px;
    align-content: start;
    gap: 5px;
  }
  .product-pane-content:has(.product-trim-stock) > * { flex-shrink: 0; }
  .product-trim-stock { margin: 0; height: 32px; }
  .product-trim-explanation { margin: 0; line-height: 1.4; }
  .product-trim-stats > div { padding: 5px 9px; }
  .product-trim-stats span { font-size: 10px; line-height: 1.2; }
  .product-trim-stats strong { font-size: 25px; line-height: 1.1; margin-top: 2px; }
  .product-trim-result { height: auto; min-height: 32px; padding: 5px 7px; line-height: 1.35; gap: 5px; }
  .product-pane-content:has(.product-trim-stock) > .product-button {
    height: 44px;
    min-height: 44px;
    margin: 0;
  }
  .product-pane-content:has(.product-trim-stock) > .product-demo-note {
    margin: 0;
    font-size: 10px;
    line-height: 14px;
  }
}
