<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Native surfaces match the current light Flutter interface in either OS mode. -->
    <style name="TrimmyWindowTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:colorBackground">@color/trimmy_paper</item>
        <item name="android:windowBackground">@color/trimmy_paper</item>
    </style>
    <style name="LaunchTheme" parent="TrimmyWindowTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="TrimmyWindowTheme" />
</resources>
