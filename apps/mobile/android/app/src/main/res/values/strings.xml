<?xml version="1.0" encoding="utf-8"?>
<!-- Text Android shows outside the Flutter screens: notification channel names
     in the phone's notification settings, and fallbacks for the workday
     reminder. The reminder's title and body normally arrive from Dart in the
     language chosen in the app; these are used only when none was saved (a
     reminder scheduled by an older version). Translations: values-es (Latin
     American Spanish, read by every Spanish phone), values-pt (Brazilian
     Portuguese, read by every Portuguese phone) and values-fr. The app's name
     stays "Trimmy" in every language (android:label in the manifest). -->
<resources>
    <!-- Notification channel for the opt-in workday reminder, as named when the app starts. -->
    <string name="notification_channel_reminders">Workday reminders</string>
    <!-- The same reminder channel's name as set when a reminder is delivered. -->
    <string name="notification_channel_check_in">Daily check-in</string>
    <!-- Notification channel for alerts when a real-money order finishes. -->
    <string name="notification_channel_trade_updates">Trade updates</string>
    <!-- Title of the workday reminder notification. "Desk" is the app's home tab. -->
    <string name="reminder_title">Your desk is waiting</string>
    <!-- Body of the workday reminder when no workday title is known. -->
    <string name="reminder_body">Your next assignment is waiting at your desk.</string>
</resources>
