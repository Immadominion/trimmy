        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/trimmy_paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_trimmy_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/trimmy_pine</item>
    </style>
</resources>
