# Public build configuration only. Leave all three unset to disable account sign-in.
# The optional Sample workspace remains available without account configuration.
# Configure this exact web origin in Privy and the API's TRIMMY_WEB_ORIGINS.
VITE_PRIVY_APP_ID=
VITE_PRIVY_APP_CLIENT_ID=
VITE_TRIMMY_API_URL=

# Optional public read-only stock research API; independent of Privy/sign-in.
# HTTPS root only. Add this web origin to the API's TRIMMY_WEB_ORIGINS.
# Never put a Tokens.xyz/Jupiter key in VITE_ variables.
VITE_TRIMMY_STOCK_API_URL=

# New practice product. Production requires a canonical HTTPS API origin and
# that exact web origin in the API allowlist. /api is for the local dev relay.
VITE_TRIMMY_PRODUCT_API_URL=

# Optional public Android APK download URL. Set once the signed build is published.
# Absolute HTTPS only; empty keeps "Download coming soon" with launch updates.
VITE_TRIMMY_ANDROID_APK_URL=
